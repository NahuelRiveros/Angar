# Variables del frontend (Vercel). Copiá este archivo como .env y completalo.
# Las dos van en Vercel → Project → Settings → Environment Variables (después, nuevo deploy).

# URL del backend en Render + /api (ej. https://mipadel.onrender.com/api); en tu PC http://localhost:3001/api
VITE_API_URL=http://localhost:3001/api

# Google Cloud → Google Auth Platform → Clients → Client ID (el mismo que GOOGLE_CLIENT_ID de Render). Vacío = sin botón de Google
VITE_GOOGLE_CLIENT_ID=
