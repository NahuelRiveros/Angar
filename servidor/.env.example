# ─────────────────────────────────────────────────────────────────
#  PLANTILLA DE VARIABLES DE ENTORNO — Dynamic Gym API
#  Copiá este archivo como ".env" y completá los valores reales.
#  NUNCA subas ".env" a git. Solo ".env.example" va al repositorio.
#
#  ARQUITECTURA EN PRODUCCIÓN (stack de siempre: Vercel + Render + Neon):
#    Frontend: https://dynamic-gym.vercel.app        (Vercel)
#    Backend:  https://dynamic-gym.onrender.com      (Render)
#    Base:     Postgres en Neon
#
#  Variables agrupadas por dónde "viven" — servidor (Render), base de datos
#  (Neon), frontend (Vercel) — con ese prefijo en el nombre para que a la
#  hora de copiarlas al panel de cada plataforma quede obvio cuál es cuál.
#  Ojo: Vercel y Render YA usan internamente nombres como VERCEL_URL o
#  RENDER_EXTERNAL_URL para sus propias variables automáticas — por eso acá
#  usamos VERCEL_FRONTEND_URL / RENDER_APP_URL en vez del nombre pelado, para
#  no confundirlas con esas.
#  Cloudinary, MercadoPago y SMTP son servicios de terceros aparte (no son
#  Vercel/Render/Neon), quedan en sus propias secciones con su propio prefijo.
# ─────────────────────────────────────────────────────────────────

# ════════════════════════════════════════════════════════════════
#  SERVIDOR (Render)
# ════════════════════════════════════════════════════════════════

NODE_ENV=development        # "development" | "production"
PORT=3001                   # Render asigna el suyo automáticamente

# URL COMPLETA de este backend en Render (para que MercadoPago le mande el
# webhook de pago confirmado). En local: dejar vacío (no llega el webhook,
# pero el resto del flujo funciona igual).
RENDER_APP_URL=
# Ejemplo producción: RENDER_APP_URL=https://dynamic-gym.onrender.com

# OBLIGATORIO en producción. Generá uno seguro con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# En Render: usá el botón "Generate" en Environment Variables.
JWT_SECRET=CAMBIA_ESTE_VALOR_POR_UNO_LARGO_Y_ALEATORIO

# SEED_SECRET (opcional pero recomendado en producción): habilita endpoints
# de administración de bajo nivel (crear/resetear cosas vía Postman) con el
# header "x-seed-token: <SEED_SECRET>", sin pasar por el login normal —
# pensados para uso puntual del desarrollador, no para el día a día.
# Si queda vacío, esos endpoints quedan DESHABILITADOS (más seguro por
# default). Poné un valor random largo, no una palabra fácil de adivinar.
SEED_SECRET=

# CORS — LOCAL: vacío (permite todo). PRODUCCIÓN: el dominio exacto de
# Vercel. Múltiples dominios separados por coma.
CORS_ORIGIN=
# Ejemplo producción: CORS_ORIGIN=https://dynamic-gym.vercel.app

# ── Seed: usuario super admin ──────────────────────────────────────
# Se crea (una sola vez) al arrancar el server si no existe todavía.
# No pisa la contraseña de un usuario ya creado en runs posteriores.
SUPERADMIN_NOMBRE=
SUPERADMIN_APELLIDO=
SUPERADMIN_DNI=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Avanzado / rara vez hace falta tocar ───────────────────────────
# QUEUE_DATA_DIR (opcional): dónde guarda gym/offline_queue_service.js la
# cola de ingresos cuando la base no responde. Por default usa ./data junto
# al server — solo hace falta cambiarlo en un entorno con filesystem
# particular (ej. testing, o un ejecutable empaquetado).
# QUEUE_DATA_DIR=

# ════════════════════════════════════════════════════════════════
#  BASE DE DATOS (Supabase en producción, Postgres local en desarrollo)
# ════════════════════════════════════════════════════════════════

# PRODUCCIÓN: connection string COMPLETO de Supabase (Connect → "Session
# pooler", puerto 5432), no solo el host. No usar "Direct connection"
# (Render free no la alcanza) ni "Transaction pooler" (pierde el search_path).
#
# Base de PRUEBAS en Supabase (proyecto rvxxbsnjenxharpwuyse).
# Direct connection: sirve desde una PC con IPv6, NO desde Render.
BD_URL=postgresql://postgres:[COMPLETAR]@db.rvxxbsnjenxharpwuyse.supabase.co:5432/postgres
# Para Render, la del Session pooler (copiar host exacto de Connect → Session pooler):
# BD_URL=postgresql://postgres.rvxxbsnjenxharpwuyse:[COMPLETAR]@[COMPLETAR].pooler.supabase.com:5432/postgres

# Schema donde viven las tablas. Solo minúsculas, números y _.
# Producción: gc_dist — pruebas: gc_dist_test (default si queda vacío).
DB_SCHEMA=gc_dist_test

# LOCAL: si BD_URL queda vacío, se arma la conexión con estas
# variables individuales en su lugar (Postgres local).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dynamicgym
DB_USER=postgres
DB_PASS=TU_PASSWORD_AQUI

# SSL: true contra Supabase (BD_URL), false con Postgres local
DB_SSL=true

# ════════════════════════════════════════════════════════════════
#  FRONTEND (Vercel)
# ════════════════════════════════════════════════════════════════

# URL COMPLETA del frontend en Vercel — para redirigir al usuario ahí
# después de pagar la suscripción del software. En local usa
# localhost:5173 si se deja vacío.
VERCEL_FRONTEND_URL=http://localhost:5173
# Ejemplo producción: VERCEL_FRONTEND_URL=https://dynamic-gym.vercel.app

# ════════════════════════════════════════════════════════════════
#  SERVICIOS DE TERCEROS (no son Vercel/Render/Neon)
# ════════════════════════════════════════════════════════════════

# ── MercadoPago (suscripción mensual AL SOFTWARE, no ventas de la tienda) ──
# Obtenelo en https://www.mercadopago.com.ar/developers/panel/app
# Token TEST para pruebas, token PROD para cobrar de verdad.
# Si queda vacío, la suscripción del software no se puede cobrar (pero el
# resto del sistema funciona normal).
MP_ACCESS_TOKEN=

# Precio mensual en ARS, SIN centavos (ej: 10000 = $10.000)
SOFTWARE_PRECIO=10000
# Nombre del cliente/gimnasio visible en la factura de MercadoPago
SOFTWARE_CLIENTE=Nombre del cliente

# ── Email / SMTP (recuperación de contraseña, notificaciones) ─────
# Con Gmail: se necesita una "contraseña de aplicación" (no la contraseña
# normal de la cuenta) — generarla en https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Formato: "Nombre visible <email@dominio.com>"
SMTP_FROM=

# ── Cloudinary (subida de imágenes: home, marcas, fotos de producto) ────
# OBLIGATORIO en producción — sin esto el servidor no arranca en Render.
# Obtenelo en https://console.cloudinary.com/console → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
