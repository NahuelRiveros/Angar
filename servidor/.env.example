# Variables del servidor (Render). Copiá este archivo como .env y completalo.
# Las marcadas [RENDER] van sí o sí en Render; [PC] solo en tu computadora. Orden alfabético, como el panel de Render.
# Revisá que no falte nada (sin mostrar valores): npm --prefix servidor run env:verificar

# Avisos por correo a SUPERADMIN_EMAIL (organizador nuevo, comprobante del plan) y al organizador (inscripción nueva, comprobante). "no" los apaga
AVISOS_POR_CORREO=si

# [RENDER] Esquema de la base: mipadel en producción, mipadel_test en tu PC (solo minúsculas)
BD_ESQUEMA=mipadel_test

# [RENDER] true con Supabase/Neon; false con el Postgres de tu PC
BD_SSL=false

# [RENDER] Conexión completa de Supabase ("Session pooler", puerto 5432): postgresql://usuario:[COMPLETAR]@host:5432/postgres — vacía en tu PC
BD_URL=

# Brevo (mails en Render): clave de API de brevo.com → SMTP & API → API Keys. Vacía = sin mails
CLAVE_API_BREVO=

# [RENDER] Cloudinary → Dashboard → API Key
CLOUDINARY_API_KEY=

# [RENDER] Cloudinary → Dashboard → API Secret
CLOUDINARY_API_SECRET=

# [RENDER] Cloudinary → Dashboard → Cloud name
CLOUDINARY_CLOUD_NAME=

# Brevo: correo remitente verificado en Brevo (ej. avisos@tudominio.com [COMPLETAR])
CORREO_REMITENTE=

# [RENDER] URL de Vercel que puede usar la API (ej. https://mipadel.vercel.app); varias, separadas por coma. Vacía en tu PC
CORS_ORIGIN=

# [PC] Postgres local: host
DB_HOST=localhost

# [PC] Postgres local: nombre de la base
DB_NAME=mipadel

# [PC] Postgres local: contraseña
DB_PASS=

# [PC] Postgres local: puerto
DB_PORT=5432

# [PC] Postgres local: usuario
DB_USER=postgres

# Google Cloud → Google Auth Platform → Clients → Client ID (el mismo que VITE_GOOGLE_CLIENT_ID). Vacío = sin "Continuar con Google"
GOOGLE_CLIENT_ID=

# [RENDER] Clave larga y al azar para las sesiones. Generala con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# MercadoPago → Developers → tu app → Access Token (hoy el cobro por MP está apagado)
MP_ACCESS_TOKEN=

# [RENDER] production en Render; development en tu PC
NODE_ENV=development

# Brevo: nombre que ve quien recibe el mail (ej. MiPadel)
NOMBRE_REMITENTE=

# [PC] Puerto local (Render pone el suyo)
PORT=3001

# Precio de 30 días del plan de organizador, en pesos sin centavos ([COMPLETAR] el precio real). Vacío = sin pago por MP
PRECIO_SUSCRIPCION_MENSUAL=

# URL de este backend en Render (ej. https://mipadel.onrender.com) para el aviso de pago de MP. Vacía en tu PC
RENDER_APP_URL=

# Clave larga y al azar para endpoints de mantenimiento. Vacía = desactivados (lo más seguro)
SEED_SECRET=

# [PC] Mails por Gmail: remitente, ej. MiPadel <tucorreo@gmail.com>
SMTP_FROM=

# [PC] Mails por Gmail: servidor
SMTP_HOST=smtp.gmail.com

# [PC] Mails por Gmail: contraseña de aplicación (myaccount.google.com/apppasswords), no la de la cuenta
SMTP_PASS=

# [PC] Mails por Gmail: puerto
SMTP_PORT=587

# [PC] Mails por Gmail: false con el puerto 587
SMTP_SECURE=false

# [PC] Mails por Gmail: tu correo
SMTP_USER=

# [RENDER] Primer super admin (se crea una sola vez al arrancar): apellido
SUPERADMIN_APELLIDO=

# [RENDER] Primer super admin: DNI
SUPERADMIN_DNI=

# [RENDER] Primer super admin: email para entrar; también recibe los avisos de organizadores nuevos y comprobantes del plan
SUPERADMIN_EMAIL=

# [RENDER] Primer super admin: nombre
SUPERADMIN_NOMBRE=

# [RENDER] Primer super admin: contraseña (larga; cambiala después de entrar)
SUPERADMIN_PASSWORD=

# [RENDER] URL del frontend en Vercel (ej. https://mipadel.vercel.app); en tu PC http://localhost:5173
VERCEL_FRONTEND_URL=http://localhost:5173
